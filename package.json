{
  "name": "philosophizer",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:debug": "bun --inspect --hot src/index.ts",
    "start": "bun src/index.ts",
    "start:network": "HOSTNAME=0.0.0.0 PORT=80 bun src/index.ts",
    "start:docker": "PORT=80 docker compose up -d",
    "stop:docker": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "bunx tsc --noEmit",
    "postgres": "docker compose up -d postgres",
    "postgres:schema": "docker compose exec -T postgres psql -U postgres -d philosophizer < src/db/schema.sql",
    "postgres:setup": "bun run postgres && sleep 3 && bun run postgres:schema",
    "postgres:reset": "docker compose stop postgres && docker volume rm philosophizer-postgres-data && bun run postgres:setup",
    "postgres:reset-preloaded": "docker compose stop postgres && docker volume rm philosophizer-postgres-data && docker compose up -d postgres",
    "pgvector:backup": "./scripts/backup-pgvector.sh",
    "pgvector:restore": "./scripts/restore-pgvector.sh",
    "pgvector:merge": "./scripts/merge-pgvector.sh",
    "pgvector:restore-remote": "docker pull mjweaver01/philosophizer-pgv-hqe:latest && docker run --rm -v $(pwd):/backup mjweaver01/philosophizer-pgv-hqe:latest cp /docker-entrypoint-initdb.d/02-data.sql /backup/pgvector-backup.sql && bun run pgvector:restore",
    "pgvector:update": "bun run pgvector:restore-remote && bun run pgvector:merge",
    "pgvector:publish": "./scripts/publish-pgvector.sh mjweaver01/philosophizer-pgv-hqe",
    "pgvector:bp": "bun run pgvector:backup && bun run pgvector:publish",
    "pgvector:pull": "docker pull mjweaver01/philosophizer-pgv-hqe:latest",
    "rag:index": "bun run src/rag/indexTexts.ts",
    "rag:reset": "bun run src/rag/indexTexts.ts --reset",
    "rag:clear": "bun run src/rag/indexTexts.ts --clear",
    "rag:stats": "bun run src/rag/indexTexts.ts --stats",
    "rag:force": "bun run src/rag/indexTexts.ts --force",
    "rag:test": "bun run src/rag/testChunking.ts",
    "backup:local": "./scripts/backup-database.sh",
    "backup:remote": "./scripts/backup-database.sh --remote \"$DATABASE_URL\"",
    "restore:local": "./scripts/restore-database.sh",
    "restore:remote": "./scripts/restore-database.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.2.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.59.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.2",
    "@ai-sdk/openai": "^3.0.2",
    "@ai-sdk/openai-compatible": "^2.0.2",
    "@ai-sdk/react": "^3.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "ai": "^6.0.6",
    "bcryptjs": "^2.4.3",
    "bun-plugin-tailwind": "^0.1.2",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "playwright": "^1.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.11.0",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.1.16",
    "use-stick-to-bottom": "^1.1.3",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  }
}
